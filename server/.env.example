# Configurações do Servidor Backend

# Porta do servidor
PORT=5000

# Supabase - Obtenha em https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=sua_url_do_supabase
SUPABASE_KEY=sua_chave_publica_do_supabase
SUPABASE_SERVICE_KEY=sua_chave_de_servico_do_supabase

# JWT Secret - Use uma string aleatória e segura
JWT_SECRET=sua_chave_secreta_jwt_muito_segura_aqui

# URL do Frontend (para CORS)
FRONTEND_URL=http://localhost:5173
